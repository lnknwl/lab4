@startuml
title Лабораторная работа №4. Вариант 4 — Шахматные фигуры
skinparam classAttributeIconSize 0

enum Color {
    White
    Black
}

abstract class ChessPiece {
    - color : Color
    - x : int
    - y : int
    - {static} whiteCount : int
    - {static} blackCount : int
    # ChessPiece(color : Color, x : int, y : int)
    # ChessPiece(other : const ChessPiece&)
    # operator=(other : const ChessPiece&) : ChessPiece&
    # isValidDestination(newX : int, newY : int) const : bool
    + ~ChessPiece()
    + {abstract} canMoveTo(newX : int, newY : int) const : bool
    + {abstract} getSymbol() const : char
    + printInfo() const : void
    + moveTo(newX : int, newY : int) : bool
    + getColor() const : Color
    + getX() const : int
    + getY() const : int
    + {static} isInsideBoard(x : int, y : int) : bool
    + {static} getWhiteCount() : int
    + {static} getBlackCount() : int
    + {static} validateBoardState(pieces : const vector<ChessPiece*>&) : bool
}

abstract class SlidingPiece {
    # SlidingPiece(color : Color, x : int, y : int)
    # isStraightMove(newX : int, newY : int) const : bool
    # isDiagonalMove(newX : int, newY : int) const : bool
}

class Rook {
    + Rook(color : Color, x : int, y : int)
    + canMoveTo(newX : int, newY : int) const : bool
    + getSymbol() const : char
    + printInfo() const : void
}

class Bishop {
    + Bishop(color : Color, x : int, y : int)
    + canMoveTo(newX : int, newY : int) const : bool
    + getSymbol() const : char
    + printInfo() const : void
}

abstract class JumpingPiece {
    # JumpingPiece(color : Color, x : int, y : int)
    # isJumpMove(newX : int, newY : int) const : bool
}

class Knight {
    + Knight(color : Color, x : int, y : int)
    + canMoveTo(newX : int, newY : int) const : bool
    + getSymbol() const : char
    + printInfo() const : void
}

interface CombinedPiece {
    + ~CombinedPiece()
    + canMoveCombined(newX : int, newY : int) const : bool
}

class Queen {
    + Queen(color : Color, x : int, y : int)
    + canMoveTo(newX : int, newY : int) const : bool
    + canMoveCombined(newX : int, newY : int) const : bool
    + getSymbol() const : char
    + printInfo() const : void
}

class King {
    + King(color : Color, x : int, y : int)
    + canMoveTo(newX : int, newY : int) const : bool
    + getSymbol() const : char
    + printInfo() const : void
}

class Board {
    - pieces : vector<ChessPiece*>
    + Board(pieces : const vector<ChessPiece*>&)
    + getPieceAt(x : int, y : int) const : const ChessPiece*
    + movePiece(fromX : int, fromY : int, toX : int, toY : int) : bool
    + isValid() const : bool
    + print() const : void
}

ChessPiece --> Color : цвет
ChessPiece <|-- King
Board o-- ChessPiece : фигуры
ChessPiece <|-- SlidingPiece
SlidingPiece <|-- Rook
SlidingPiece <|-- Bishop
ChessPiece <|-- JumpingPiece
JumpingPiece <|-- Knight
SlidingPiece <|-- Queen
CombinedPiece <|.. Queen
@enduml
